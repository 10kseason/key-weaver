if(NOT DEFINED KEYWEAVER_EXE OR NOT DEFINED TEST_ROOT)
    message(FATAL_ERROR "KEYWEAVER_EXE and TEST_ROOT are required")
endif()

# Every run owns a fresh directory; never clear a caller's output folder.
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef run_id)
set(work "${TEST_ROOT}/nk2-batch-${run_id}")
file(MAKE_DIRECTORY "${work}")
set(inputs)
set(objects "")
foreach(note RANGE 0 79)
    math(EXPR lane "${note} % 7")
    math(EXPR x "(${lane} * 2 + 1) * 512 / 14")
    math(EXPR time "1000 + ${note} * 600")
    string(APPEND objects "${x},192,${time},1,0,0:0:0:0:\n")
endforeach()
foreach(index RANGE 1 16)
    file(MAKE_DIRECTORY "${work}/input-${index}")
    set(input "${work}/input-${index}/same.osu")
    file(WRITE "${input}" "osu file format v14\n[General]\nMode:3\n[Metadata]\nTitle:Batch fixture ${index}\nVersion:Native\n[Difficulty]\nCircleSize:7\n[TimingPoints]\n0,500,4,2,1,70,1,0\n[HitObjects]\n${objects}")
    list(APPEND inputs "${input}")
endforeach()

foreach(jobs IN ITEMS 1 16)
    set(output_dir "${work}/output-${jobs}")
    execute_process(COMMAND "${KEYWEAVER_EXE}" ${inputs} --target 10 --engine nk2
        --nk2-mode faithful --batch --jobs ${jobs} --batch-quiet --out-dir "${output_dir}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 45)
    if(NOT result STREQUAL "0" OR NOT output MATCHES "succeeded=16 failed=0 skipped=0")
        message(FATAL_ERROR "NK2 batch failed (${result}): ${output}\n${error}")
    endif()
    file(GLOB charts "${output_dir}/*.osu")
    list(LENGTH charts count)
    if(NOT count EQUAL 16)
        message(FATAL_ERROR "NK2 --jobs ${jobs} reported success but wrote ${count}/16 charts")
    endif()
    set(titles)
    foreach(chart IN LISTS charts)
        file(READ "${chart}" text)
        string(REGEX MATCH "Title:Batch fixture [0-9]+" title "${text}")
        list(APPEND titles "${title}")
    endforeach()
    list(REMOVE_DUPLICATES titles)
    list(LENGTH titles unique_count)
    if(NOT unique_count EQUAL 16)
        message(FATAL_ERROR "NK2 --jobs ${jobs} did not preserve all input titles")
    endif()
endforeach()

# The generated run directory is a direct child of the supplied build directory.
cmake_path(ABSOLUTE_PATH TEST_ROOT NORMALIZE OUTPUT_VARIABLE root_absolute)
cmake_path(ABSOLUTE_PATH work NORMALIZE OUTPUT_VARIABLE work_absolute)
cmake_path(GET work_absolute PARENT_PATH work_parent)
if(NOT work_parent STREQUAL root_absolute)
    message(FATAL_ERROR "Refusing cleanup outside the test build directory")
endif()
file(REMOVE_RECURSE "${work_absolute}")
