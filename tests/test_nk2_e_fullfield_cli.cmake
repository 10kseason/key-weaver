if(NOT DEFINED KEYWEAVER_EXE OR NOT DEFINED TEST_ROOT)
    message(FATAL_ERROR "KEYWEAVER_EXE and TEST_ROOT are required")
endif()
cmake_path(ABSOLUTE_PATH TEST_ROOT NORMALIZE OUTPUT_VARIABLE root)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef run_id)
set(work "${root}/e-fullfield-cli-${run_id}")
file(MAKE_DIRECTORY "${work}")

function(run_ok)
    execute_process(COMMAND "${KEYWEAVER_EXE}" ${ARGN} RESULT_VARIABLE code
        OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
    if(NOT code STREQUAL "0")
        message(FATAL_ERROR "E+ CLI failed: ${code}\n${output}\n${error}")
    endif()
endfunction()
function(same_bytes a b)
    file(SHA256 "${a}" a_hash)
    file(SHA256 "${b}" b_hash)
    if(NOT a_hash STREQUAL b_hash)
        message(FATAL_ERROR "Non-deterministic E+ output: ${a} / ${b}")
    endif()
endfunction()

set(input "${work}/native.osu")
file(WRITE "${input}" "osu file format v14\n[General]\nMode:3\n[Metadata]\nTitle:E+ fixture\nVersion:Native\n[Difficulty]\nCircleSize:7\n[TimingPoints]\n0,500,4,2,1,70,1,0\n[HitObjects]\n")
foreach(i RANGE 0 39)
    math(EXPR time "1000 + ${i} * 600")
    math(EXPR x "(2 * (${i} % 7) + 1) * 512 / 14")
    file(APPEND "${input}" "${x},192,${time},1,0,0:0:0:0:\n")
endforeach()
file(SHA256 "${input}" source_hash)
set(e --engine nk2 --target 10 --nk2-mode faithful --nk2-search phrase
    --nk2-phrase-support --nk2-phrase-dense-ln --nk2-phrase-source-ln)
run_ok("${input}" ${e} --nk2-e-fullfield --out "${work}/plus.osu" --report "${work}/plus.json"
    --pattern-hotspot-report "${work}/plus-hotspots.json")
run_ok("${input}" --engine nk2 --target 10 --nk2-e-fullfield
    --out "${work}/auto.osu" --report "${work}/auto.json"
    --pattern-hotspot-report "${work}/auto-hotspots.json")
same_bytes("${work}/plus.osu" "${work}/auto.osu")
same_bytes("${work}/plus.json" "${work}/auto.json")
same_bytes("${work}/plus-hotspots.json" "${work}/auto-hotspots.json")
file(READ "${work}/plus-hotspots.json" diagnostic)
string(JSON preset GET "${diagnostic}" preset)
file(READ "${work}/plus.json" report)
string(JSON passed GET "${report}" independentSafety passed)
string(JSON reverted GET "${report}" fullFieldTransform reverted)
string(JSON moved GET "${report}" fullFieldTransform movedNotes)
if(NOT preset STREQUAL "E+" OR NOT passed OR reverted OR NOT moved GREATER 0)
    message(FATAL_ERROR "E+ CLI must identify and safely redistribute its final population")
endif()
run_ok("${input}" ${e} --nk2-e-fullfield --out-dir "${work}/default")
file(GLOB named "${work}/default/*-fullfield-v2.osu")
list(LENGTH named named_count)
if(NOT named_count EQUAL 1)
    message(FATAL_ERROR "E+ default filename must be distinct from E")
endif()
same_bytes("${work}/plus.osu" "${named}")
run_ok("${input}" ${e} --nk2-e-fullfield --dry-run --out "${work}/dry.osu")
if(EXISTS "${work}/dry.osu")
    message(FATAL_ERROR "E+ dry-run exported a chart")
endif()
foreach(variant IN ITEMS classic target boost legacy)
    set(invalid ${e} --nk2-e-fullfield)
    if(variant STREQUAL classic)
        set(invalid --engine classic --target 10 --nk2-e-fullfield)
    elseif(variant STREQUAL target)
        list(APPEND invalid --target 7)
    elseif(variant STREQUAL boost)
        list(APPEND invalid --nk2-phrase-source-ln-boost)
    else()
        set(invalid --engine nk2 --target 10 --nk2-mode faithful --nk2-e-fullfield)
    endif()
    execute_process(COMMAND "${KEYWEAVER_EXE}" "${input}" ${invalid} --out "${work}/rejected.osu"
        RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
    if(NOT code MATCHES "^[0-9]+$" OR code STREQUAL "0" OR EXISTS "${work}/rejected.osu")
        message(FATAL_ERROR "E+ accepted unsupported ${variant}: ${output}\n${error}")
    endif()
endforeach()
# Exercise the batch route used by the GUI, with deterministic parallel jobs.
file(COPY_FILE "${input}" "${work}/second.osu")
run_ok("${input}" "${work}/second.osu" ${e} --nk2-e-fullfield --batch --jobs 2 --batch-quiet
    --out-dir "${work}/batch")
file(GLOB batch "${work}/batch/*.osu")
list(LENGTH batch batch_count)
if(NOT batch_count EQUAL 2)
    message(FATAL_ERROR "E+ batch must export both native inputs")
endif()
foreach(output IN LISTS batch)
    same_bytes("${work}/plus.osu" "${output}")
endforeach()
# Explicit 10K E+ overrides E's same-key no-op without changing its population.
file(READ "${input}" native_text)
string(REPLACE "CircleSize:7" "CircleSize:10" native_text "${native_text}")
file(WRITE "${work}/native10.osu" "${native_text}")
run_ok("${work}/native10.osu" ${e} --out "${work}/noop.osu")
if(EXISTS "${work}/noop.osu")
    message(FATAL_ERROR "Plain same-key E unexpectedly exported a chart")
endif()
run_ok("${work}/native10.osu" ${e} --nk2-e-fullfield --out-dir "${work}/same-key"
    --report "${work}/same-key.json")
file(GLOB same_key "${work}/same-key/*-fullfield-v2.osu")
list(LENGTH same_key same_key_count)
file(READ "${work}/same-key.json" same_key_report)
string(JSON same_moved GET "${same_key_report}" fullFieldTransform movedNotes)
if(NOT same_key_count EQUAL 1 OR NOT same_moved GREATER 0)
    message(FATAL_ERROR "Explicit same-key E+ must export a real redistribution")
endif()
# BMS stays BMS; the diagnostic still observes pre-export normalized events.
file(WRITE "${work}/native.bms" "#TITLE Native\n#BPM 120\n#WAV01 fixture.wav\n#00111:01000100\n#00212:01000100\n#00313:01000100\n")
run_ok("${work}/native.bms" ${e} --nk2-e-fullfield --out-dir "${work}/bms"
    --pattern-hotspot-report "${work}/bms-hotspots.json")
file(GLOB bms "${work}/bms/*.bms")
file(GLOB bms_osu "${work}/bms/*.osu")
list(LENGTH bms bms_count)
if(NOT bms_count EQUAL 1 OR bms_osu)
    message(FATAL_ERROR "E+ BMS-family output changed formats")
endif()
run_ok("${input}" ${e} --nk2-e-fullfield --nk2-e-tap-boost --out "${work}/taps.osu"
    --report "${work}/taps.json" --pattern-hotspot-report "${work}/taps-hotspots.json")
run_ok("${input}" --engine nk2 --target 10 --nk2-e-fullfield --nk2-e-tap-boost
    --out-dir "${work}/taps-auto" --report "${work}/taps-auto.json"
    --pattern-hotspot-report "${work}/taps-auto-hotspots.json")
file(GLOB taps_named "${work}/taps-auto/*-fullfield-v2-taps-v2.osu")
list(LENGTH taps_named taps_named_count)
if(NOT taps_named_count EQUAL 1)
    message(FATAL_ERROR "Tap boost needs a distinct default filename")
endif()
same_bytes("${work}/taps.osu" "${taps_named}")
same_bytes("${work}/taps.json" "${work}/taps-auto.json")
same_bytes("${work}/taps-hotspots.json" "${work}/taps-auto-hotspots.json")
file(READ "${work}/taps.json" taps_report)
file(READ "${work}/taps-hotspots.json" taps_hotspots)
string(JSON taps_added GET "${taps_report}" fullFieldTapBoost addedTaps)
string(JSON taps_passed GET "${taps_report}" independentSafety passed)
string(JSON taps_policy GET "${taps_report}" independentSafety repeatPolicy)
string(JSON taps_strict GET "${taps_report}" independentSafety strict500CreatedRepeats)
string(JSON taps_allowed GET "${taps_report}" independentSafety tempoAllowedTapRepeats)
string(JSON taps_violations GET "${taps_report}" independentSafety createdLaneRepeats)
math(EXPR taps_repeat_total "${taps_allowed}+${taps_violations}")
if(NOT taps_policy STREQUAL "new_taps_half_beat_180_500ms" OR NOT taps_strict EQUAL taps_repeat_total)
    message(FATAL_ERROR "Effective tap safety must expose the strict repeat count and explicit policy")
endif()
string(JSON taps_stage GET "${taps_report}" fullFieldTransform analysisStage)
string(JSON taps_count GET "${taps_report}" placement outputNotes)
string(JSON audit_count GET "${taps_hotspots}" patternHotspots totalNotes)
string(JSON taps_preset GET "${taps_hotspots}" preset)
if(NOT taps_added GREATER 0 OR NOT taps_passed OR NOT taps_stage STREQUAL "before_tap_boost" OR
   NOT taps_count EQUAL audit_count OR NOT taps_preset STREQUAL "E+ taps")
    message(FATAL_ERROR "Tap boost report must identify actual additions and final diagnostic population")
endif()
run_ok("${input}" "${work}/second.osu" ${e} --nk2-e-fullfield --nk2-e-tap-boost
    --batch --jobs 2 --batch-quiet --out-dir "${work}/taps-batch")
file(GLOB taps_batch "${work}/taps-batch/*.osu")
list(LENGTH taps_batch taps_batch_count)
if(NOT taps_batch_count EQUAL 2)
    message(FATAL_ERROR "Tap boost batch did not export both inputs")
endif()
foreach(output IN LISTS taps_batch)
    same_bytes("${work}/taps.osu" "${output}")
endforeach()
run_ok("${work}/native.bms" ${e} --nk2-e-fullfield --nk2-e-tap-boost --out-dir "${work}/taps-bms")
file(GLOB taps_bms "${work}/taps-bms/*-taps-v2.bms")
list(LENGTH taps_bms taps_bms_count)
if(NOT taps_bms_count EQUAL 1)
    message(FATAL_ERROR "Tap boost BMS output must stay BMS-family")
endif()
execute_process(COMMAND "${KEYWEAVER_EXE}" "${input}" ${e} --nk2-e-tap-boost --out "${work}/no-fullfield.osu"
    RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
if(NOT code MATCHES "^[0-9]+$" OR code STREQUAL "0" OR EXISTS "${work}/no-fullfield.osu" OR
   NOT error MATCHES "requires --nk2-e-fullfield")
    message(FATAL_ERROR "Tap boost without E+ must fail before writing: ${output}\n${error}")
endif()
# The same preset and single/batch routes must target the actual eight lanes.
set(e8 --engine nk2 --target 8 --nk2-mode faithful --nk2-search phrase
    --nk2-phrase-support --nk2-phrase-dense-ln --nk2-phrase-source-ln)
run_ok("${input}" ${e8} --nk2-e-fullfield --nk2-e-tap-boost --out "${work}/taps8.osu"
    --report "${work}/taps8.json" --pattern-hotspot-report "${work}/taps8-hotspots.json")
run_ok("${input}" --engine nk2 --target 8 --nk2-e-fullfield --nk2-e-tap-boost --out-dir "${work}/taps8-auto"
    --report "${work}/taps8-auto.json" --pattern-hotspot-report "${work}/taps8-auto-hotspots.json")
file(GLOB named8 "${work}/taps8-auto/*KeyWeaverNK2-8K*-fullfield-v2-taps-v2.osu")
list(LENGTH named8 named8_count)
if(NOT named8_count EQUAL 1)
    message(FATAL_ERROR "8K tap boost needs its own default filename")
endif()
same_bytes("${work}/taps8.osu" "${named8}")
same_bytes("${work}/taps8.json" "${work}/taps8-auto.json")
same_bytes("${work}/taps8-hotspots.json" "${work}/taps8-auto-hotspots.json")
file(READ "${work}/taps8.osu" chart8)
file(READ "${work}/taps8.json" report8)
file(READ "${work}/taps8-hotspots.json" hotspot8)
string(JSON lanes8 LENGTH "${report8}" fullFieldTapBoost addedLaneCounts)
string(JSON passed8 GET "${report8}" independentSafety passed)
string(JSON hotspot_lanes8 GET "${hotspot8}" patternHotspots laneCount)
string(JSON hotspot_notes8 GET "${hotspot8}" patternHotspots totalNotes)
string(JSON output_notes8 GET "${report8}" placement outputNotes)
if(NOT chart8 MATCHES "CircleSize:8" OR NOT lanes8 EQUAL 8 OR NOT passed8 OR
   NOT hotspot_lanes8 EQUAL 8 OR NOT hotspot_notes8 EQUAL output_notes8)
    message(FATAL_ERROR "8K serialization, lane counters or final diagnostic count is inconsistent")
endif()
run_ok("${input}" "${work}/second.osu" ${e8} --nk2-e-fullfield --nk2-e-tap-boost --batch --jobs 2
    --batch-quiet --out-dir "${work}/taps8-batch")
file(GLOB batch8 "${work}/taps8-batch/*.osu")
list(LENGTH batch8 batch8_count)
if(NOT batch8_count EQUAL 2)
    message(FATAL_ERROR "8K batch did not export both inputs")
endif()
foreach(output IN LISTS batch8)
    same_bytes("${work}/taps8.osu" "${output}")
endforeach()
string(REPLACE "CircleSize:10" "CircleSize:8" native8 "${native_text}")
file(WRITE "${work}/native8.osu" "${native8}")
run_ok("${work}/native8.osu" ${e8} --nk2-e-fullfield --nk2-e-tap-boost --out-dir "${work}/same-key8")
file(GLOB same8 "${work}/same-key8/*KeyWeaverNK2-8K*-fullfield-v2-taps-v2.osu")
list(LENGTH same8 same8_count)
if(NOT same8_count EQUAL 1)
    message(FATAL_ERROR "Explicit same-key 8K E+ taps must export with 8K metadata")
endif()
run_ok("${work}/native.bms" ${e8} --nk2-e-fullfield --nk2-e-tap-boost --out-dir "${work}/taps8-bms")
file(GLOB bms8 "${work}/taps8-bms/*-taps-v2.bms")
file(GLOB wrong8 "${work}/taps8-bms/*.osu")
list(LENGTH bms8 bms8_count)
if(NOT bms8_count EQUAL 1 OR wrong8)
    message(FATAL_ERROR "8K BMS tap boost must retain its BMS output format")
endif()
file(SHA256 "${input}" source_after)
if(NOT source_hash STREQUAL source_after)
    message(FATAL_ERROR "E+ changed its input")
endif()
cmake_path(GET work PARENT_PATH parent)
if(NOT parent STREQUAL root)
    message(FATAL_ERROR "Refusing cleanup outside build directory")
endif()
file(REMOVE_RECURSE "${work}")
message(STATUS "E+ CLI auto/explicit, safety, deterministic reports, filenames, batch and rejection passed")
