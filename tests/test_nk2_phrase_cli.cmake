function(run_success label)
    execute_process(COMMAND "${KEYWEAVER_EXE}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "${label} failed (${result}): ${output}\n${error}")
    endif()
    set(last_output "${output}" PARENT_SCOPE)
endfunction()

function(run_failure label input target mode search)
    set(chart_path "${work}/${label}.osu")
    execute_process(COMMAND "${KEYWEAVER_EXE}" "${input}" --engine nk2
        --target "${target}" --nk2-mode "${mode}" --nk2-search "${search}"
        --out "${chart_path}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
    # Timeouts/crashes must not masquerade as a successful validation rejection.
    if(NOT result MATCHES "^[0-9]+$" OR result STREQUAL "0" OR
       NOT error MATCHES "error:" OR EXISTS "${chart_path}")
        message(FATAL_ERROR "${label} did not reject without chart output (${result}): ${output}\n${error}")
    endif()
endfunction()

function(assert_same_bytes label left right)
    file(SHA256 "${left}" left_hash)
    file(SHA256 "${right}" right_hash)
    if(NOT left_hash STREQUAL right_hash)
        message(FATAL_ERROR "${label} chart bytes differ")
    endif()
endfunction()

function(assert_resolved_mode report_path mode search source_ln)
    file(READ "${report_path}" resolved_json)
    string(JSON resolved_mode GET "${resolved_json}" mode)
    string(JSON resolved_search GET "${resolved_json}" phraseSearch enabled)
    string(JSON resolved_source_ln GET "${resolved_json}" phraseSearch sourceLn)
    string(JSON resolved_boost GET "${resolved_json}" phraseSearch sourceLnBoost)
    if(NOT resolved_mode STREQUAL mode OR NOT resolved_search STREQUAL search OR
       NOT resolved_source_ln STREQUAL source_ln OR resolved_boost)
        message(FATAL_ERROR "Unexpected resolved NK2 mode in ${report_path}")
    endif()
    if(search)
        string(JSON resolved_passed GET "${resolved_json}" independentSafety passed)
        if(NOT resolved_passed)
            message(FATAL_ERROR "Automatic phrase selection must pass its independent audit")
        endif()
    endif()
endfunction()

function(assert_preserved_hit_objects label before after)
    file(STRINGS "${before}" original_lines)
    file(STRINGS "${after}" remaining_lines)
    set(in_hit_objects FALSE)
    foreach(line IN LISTS original_lines)
        if(line STREQUAL "[HitObjects]")
            set(in_hit_objects TRUE)
        elseif(in_hit_objects AND NOT line STREQUAL "")
            list(FIND remaining_lines "${line}" original_index)
            if(original_index EQUAL -1)
                message(FATAL_ERROR "${label} changed or removed a HitObject: ${line}")
            endif()
            # Consume one occurrence so duplicated original objects cannot hide a loss.
            list(REMOVE_AT remaining_lines ${original_index})
        endif()
    endforeach()
endfunction()

function(assert_hold_span label chart begin end expected_count)
    file(STRINGS "${chart}" hold_lines)
    set(hold_count 0)
    foreach(line IN LISTS hold_lines)
        if(line MATCHES "^[^,]+,[^,]+,(-?[0-9]+),128,[^,]+,(-?[0-9]+):")
            if(CMAKE_MATCH_1 LESS begin OR CMAKE_MATCH_2 GREATER end OR NOT CMAKE_MATCH_2 GREATER CMAKE_MATCH_1)
                message(FATAL_ERROR "${label} hold escaped the original LN span: ${line}")
            endif()
            math(EXPR hold_count "${hold_count} + 1")
        endif()
    endforeach()
    if(NOT hold_count EQUAL expected_count)
        message(FATAL_ERROR "${label} report and exported hold count disagree")
    endif()
endfunction()

