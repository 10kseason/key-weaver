# Every explicit preset is available for expansion, reduction, and equal keys.
# Cover both key-count boundaries and sources that were never in the 4K/7K allowlist.
foreach(pair IN ITEMS 1-3 2-18 4-1 6-9 12-3 18-1 18-18)
    string(REPLACE "-" ";" counts "${pair}")
    list(GET counts 0 source_keys)
    list(GET counts 1 target_keys)
    string(REPLACE "CircleSize:7" "CircleSize:${source_keys}" any_header "${header}")
    set(any_input "${work}/source-${source_keys}.osu")
    file(WRITE "${any_input}" "${any_header}${objects}")
    set(preset_args)
    foreach(preset IN ITEMS B C D E F)
        if(preset STREQUAL C)
            list(APPEND preset_args --nk2-phrase-support)
        elseif(preset STREQUAL D)
            list(APPEND preset_args --nk2-phrase-dense-ln)
        elseif(preset STREQUAL E)
            list(APPEND preset_args --nk2-phrase-source-ln)
        elseif(preset STREQUAL F)
            list(APPEND preset_args --nk2-phrase-source-ln-boost)
        endif()
        set(any_prefix "${work}/any-${pair}-${preset}")
        run_success("${pair} preset ${preset}" "${any_input}" --engine nk2 --target "${target_keys}"
            --nk2-mode faithful --nk2-search phrase ${preset_args}
            --out "${any_prefix}.osu" --report "${any_prefix}.json")
        file(READ "${any_prefix}.json" any_json)
        string(JSON any_passed GET "${any_json}" independentSafety passed)
        string(JSON any_added GET "${any_json}" placement addedNotes)
        string(JSON any_search GET "${any_json}" phraseSearch enabled)
        string(JSON any_support GET "${any_json}" phraseSearch supportNotes)
        string(JSON any_dense GET "${any_json}" phraseSearch denseLn)
        string(JSON any_source_ln GET "${any_json}" phraseSearch sourceLn)
        string(JSON any_boost GET "${any_json}" phraseSearch sourceLnBoost)
        string(JSON any_outside GET "${any_json}" independentSafety generatedHoldsOutsideSourceLn)
        if(NOT any_passed OR NOT any_search OR
           (preset MATCHES "^[EF]$" AND NOT any_outside EQUAL 0))
            message(FATAL_ERROR "${pair} preset ${preset} must pass the independent audit")
        endif()
        if((preset STREQUAL B AND (any_support OR NOT any_added EQUAL 0)) OR
           (NOT preset STREQUAL B AND NOT any_support) OR
           (preset MATCHES "^[DEF]$" AND NOT any_dense) OR
           (preset MATCHES "^[EF]$" AND NOT any_source_ln) OR
           (preset STREQUAL F AND NOT any_boost))
            message(FATAL_ERROR "${pair} preset ${preset} silently lost its requested options")
        endif()
        if(source_keys EQUAL target_keys)
            string(JSON any_noop GET "${any_json}" noOp)
            string(JSON any_mutated GET "${any_json}" chartMutated)
            string(JSON any_dropped GET "${any_json}" independentSafety droppedSourceNotes)
            string(JSON any_retimed GET "${any_json}" independentSafety retimedSourceNotes)
            if(NOT any_noop OR any_mutated OR NOT any_added EQUAL 0 OR
               NOT any_dropped EQUAL 0 OR NOT any_retimed EQUAL 0 OR
               EXISTS "${any_prefix}.osu" OR NOT last_output MATCHES "No chart output written")
                message(FATAL_ERROR "Same-key preset ${preset} must report a no-op without writing a chart")
            endif()
            continue()
        endif()
        file(READ "${any_prefix}.osu" any_chart)
        if(NOT any_chart MATCHES "CircleSize:${target_keys}([^0-9]|$)")
            message(FATAL_ERROR "${pair} preset ${preset} must export its target key count")
        endif()
        if(preset STREQUAL F)
            assert_preserved_hit_objects("${pair} F preserves E" "${work}/any-${pair}-E.osu" "${any_prefix}.osu")
        endif()
    endforeach()
endforeach()

