    set(batch_support_args)
    set(batch_target 4)
    if(NOT variant STREQUAL "phrase")
        set(batch_support_args --nk2-phrase-support)
        set(batch_target 10)
    endif()
    if(variant MATCHES "^phrase-notes-dense-ln")
        list(APPEND batch_support_args --nk2-phrase-dense-ln)
