    if(variant MATCHES "^phrase-notes-dense-ln-source-ln")
        list(APPEND batch_support_args --nk2-phrase-source-ln)
    endif()
    if(variant STREQUAL "phrase-notes-dense-ln-source-ln-boost")
        list(APPEND batch_support_args --nk2-phrase-source-ln-boost)
    endif()
    foreach(jobs IN ITEMS 1 2)
        set(output_dir "${work}/batch-${variant}-${jobs}")
        run_success("${variant} batch jobs=${jobs}" ${batch_inputs} --engine nk2 --target "${batch_target}"
            --nk2-mode faithful --nk2-search phrase ${batch_support_args} --batch --jobs "${jobs}" --batch-quiet
            --out-dir "${output_dir}")
        if(NOT last_output MATCHES "succeeded=2 failed=0 skipped=0")
            message(FATAL_ERROR "${variant} batch did not report both inputs successful: ${last_output}")
        endif()
        file(GLOB batch_charts "${output_dir}/*.osu")
        list(LENGTH batch_charts chart_count)
        if(NOT chart_count EQUAL 2)
            message(FATAL_ERROR "${variant} batch jobs=${jobs} did not preserve 2/2 files")
        endif()
        set(hashes)
        set(titles)
        foreach(chart IN LISTS batch_charts)
            file(READ "${chart}" chart_text)
            string(REGEX MATCH "Title:Phrase batch [12]" title "${chart_text}")
            list(APPEND titles "${title}")
            if(NOT chart MATCHES "-${variant}" OR NOT chart_text MATCHES "KeyWeaverNK2-${batch_target}K-${variant}")
                message(FATAL_ERROR "${variant} batch filename and difficulty marker must identify the search")
            endif()
            file(SHA256 "${chart}" hash)
            list(APPEND hashes "${hash}")
        endforeach()
        list(REMOVE_DUPLICATES titles)
        list(LENGTH titles title_count)
        if(NOT title_count EQUAL 2)
            message(FATAL_ERROR "${variant} batch lost an input title")
        endif()
        list(SORT hashes)
        if(jobs EQUAL 1)
            set(serial_hashes "${hashes}")
        elseif(NOT hashes STREQUAL serial_hashes)
            message(FATAL_ERROR "Serial and parallel ${variant} outputs differ")
        endif()
    endforeach()
endforeach()

